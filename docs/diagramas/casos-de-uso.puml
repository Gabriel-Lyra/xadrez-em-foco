@startuml
!include _style.iuml
left to right direction
actor "Enxadrista\n(usuário)" as U
actor "Desenvolvedor" as D
rectangle "Xadrez em Foco" {
  usecase "UC01 Enviar captura\nde tela" as UC1
  usecase "UC02 Reconhecer\nposição" as UC2
  usecase "Detectar tabuleiro\n(RF02)" as I1
  usecase "Identificar peças\n(RF03)" as I2
  usecase "Gerar FEN\n(RF04)" as I3
  usecase "UC03 Visualizar e\ncopiar FEN" as UC3
  usecase "UC04 Inverter\norientação" as UC4
  usecase "UC05 Abrir posição\nno Lichess" as UC5
  usecase "UC06 Treinar e publicar\nmodelo de reconhecimento" as UC6
}
actor "Lichess\n(sistema externo)" as L <<sistema>>
U --> UC1
U --> UC3
U --> UC5
UC1 ..> UC2 : <<include>>
UC2 ..> I1 : <<include>>
UC2 ..> I2 : <<include>>
UC2 ..> I3 : <<include>>
UC4 ..> UC3 : <<extend>>
UC5 --> L
D --> UC6
@enduml
